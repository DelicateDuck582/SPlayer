{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "electron/main/**/*.d.ts",
    "electron/main/index.ts",
    "electron/main/logger/index.ts",
    "electron/main/store/index.ts",
    "electron/main/utils.ts",
    "electron/main/index.d.ts",
    "electron/preload/index.d.ts",
    "electron/preload/index.ts",
    "src/assets/data/*",
    "src/types/shared",
    "scripts/*",
    // 安全自检脚本（scripts/security-selfcheck.ts）引用的共享纯函数模块；
    // 需显式列出，否则 IDE 以 composite 模式检查时会报 TS6307「文件不在项目文件列表中」
    "src/utils/download-security.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@emi": ["./native/external-media-integration"],
      "@native/*": ["./native/*"],
      "@shared": ["./src/types/shared"]
    }
  }
}
